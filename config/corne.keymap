#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define HOST_OS 2 // Mac OS
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"
#include "zmk-helpers/unicode-chars/french.dtsi"

#define DEF 0
#define NUM 1
#define SYM 2
#define FUN 3

#define ___ &trans
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH0 LH1 LH2 RH0 RH1 RH2

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

#define COMBO_TERM 50
#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

        //    ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
        //                       LT4              LT3              LT2              LT1              LT0                  RT0              RT1              RT2              RT3              RT4            
        //    ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
        //                       LM4              LM3              LM2              LM1              LM0                  RM0              RM1              RM2              RM3              RM4            
        //    ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
        //                       LB4              LB3              LB2              LB1              LB0                  RB0              RB1              RB2              RB3              RB4            
        //    ╰────────────────┴────────────────┴────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┴────────────────┴────────────────╯
        //                                                         LH2              LH1              LH0                  RH0              RH1              RH2
        //                                                       ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
// Vertical Combos - Left
ZMK_COMBO(excl, &kp N1, LT4 LM4)        // Q + A => 1 !
ZMK_COMBO(at, &kp N2, LT3 LM3)          // W + S => 2 @
ZMK_COMBO(hash, &kp N3, LT2 LM2)        // E + D => 3 #
ZMK_COMBO(dollar, &kp N4, LT1 LM1)      // R + F => 4 $
ZMK_COMBO(percent, &kp N5, LT0 LM0)     // T + G => 5 %
// Vertical Combos - Right
ZMK_COMBO(caret, &kp N6, RT0 RM0)       // Y + H => 6 ^
ZMK_COMBO(ampersand, &kp N7, RT1 RM1)   // U + J => 7 &
ZMK_COMBO(asterisk, &kp N8, RT2 RM2)    // I + K => 8 *
ZMK_COMBO(lparen, &kp N9, RT3 RM3)      // O + L => 9 (
ZMK_COMBO(rparen, &kp N0, RT4 RM4)      // P + ; => 0 )
// Horizontal Combos - Top Left
ZMK_COMBO(esc, &kp ESC, LT4 LT3)        // Q + W => ESC
ZMK_COMBO(backtick, &kp GRAVE, LT4 LB0) // Q + B => `
ZMK_COMBO(vsc_t, &kp LC(GRAVE), LT4 LB1) // Q + V => CTRL + `
// Horizontal Combos - Middle Left
// ZMK_COMBO(tab, &kp TAB, LM3 LM2) // S + D
// Horizontal Combos - Bottom Left
ZMK_COMBO(undo, &kp LG(Z), LB4 LB0)     // Z + B => CMD + Z
ZMK_COMBO(cut, &kp LG(X), LB4 LB3)      // Z + X => CMD + X
ZMK_COMBO(copy, &kp LG(C), LB4 LB2)     // Z + C => CMD + C
ZMK_COMBO(paste, &kp LG(V), LB4 LB1)    // Z + V => CMD + V
// Horizontal Combos - Top Right
ZMK_COMBO(minus, &kp MINUS, RT2 RT3)    // I + O => -
ZMK_COMBO(equal, &kp EQUAL, RT3 RT4)    // O + P => =
// Horizontal Combos - Middle Right
// ZMK_COMBO(enter, &kp ENTER, RM2 RM3) // K + L
// Horizontal Combos - Bottom Right
ZMK_COMBO(apos, &kp APOS, RM3 RM4)      // L + ; => '

ZMK_LAYER(default_layer,
        //    ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                &none            &kp Q            &kp W            &kp E            &kp R            &kp T                &kp Y            &kp U            &kp I            &kp O            &kp P            &none
        //    ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                &none            &hml LCTRL A     &hml LALT S      &hml LGUI D      &hml LSHFT F     &kp G                &kp H            &hmr RSHFT J     &hmr RGUI K      &hmr RALT L      &hmr RCTRL SEMI  &none
        //    ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                &none            &kp Z            &kp X            &kp C            &kp V            &kp B                &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &none
        //    ╰────────────────┴────────────────┴────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┴────────────────┴────────────────╯
                                                                   &kp ESC          &kp TAB          &kp SPACE            &kp RET          &kp BSPC         &kp DEL
        //                                                     ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯

)